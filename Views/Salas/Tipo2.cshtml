@{
    ViewData["Title"] = "Tipo 2";
}
<!-- View for Tipo2. Tipo 2 va a mostrar el nombre de la habitación en un h1, tener un texto en un p, una imagen en un img. Van a haber 4 imagenes uno al lado de otro que cuando se toquen va a aparecer un pop up cuadrado con informacion que se puede cerrar -->
<h1>@ViewBag.sala.Nombre</h1>
<p>@ViewBag.sala.Texto</p>
<img src="@ViewBag.sala.Imagen" alt="Imagen de la sala">
<!-- 4 imagenes que cuando se toquen va a aparecer un pop up cuadrado con informacion que está en una ViewBag.Archivos (que es como un array de strings) se puede cerrar -->
<div class="imagenes">
    @for (int i = 0; i < ViewBag.sala.Archivos.Count; i++)
    {
        <img src="@ViewBag.sala.Archivos[i]" alt="Imagen @i" class="imagen" onclick="mostrarPopUp(@i)">
    }
</div>
<div class="pop-up" id="popUp">
    <div class="pop-up-content">
        <span class="close" onclick="cerrarPopUp()">&times;</span>
        <img id="popUpImagen" src="" alt="Imagen del pop up">
        <p id="popUpTexto"></p>
    </div>
</div>
    
