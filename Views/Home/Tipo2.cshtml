@{
    ViewData["Title"] = "Tipo 2";
}
<div class="sala-container">
    <h1 class="titulo-terror">@ViewBag.sala.Nombre</h1>
    <p class="texto-descripcion">@ViewBag.sala.Texto</p>
    <div class="imagen-frame">
        <img src="@ViewBag.sala.Imagen" alt="Imagen de la sala">
    </div>

    <div class="archivos-container">
        @for (int i = 0; i < ViewBag.Archivos.Length; i++)
        {
            <input type="hidden" id="archivo-@i" value="@ViewBag.Archivos[i]" />
            <img class="foto-archivo" src="/images/fotoArchivo.jpg" alt="Imagen @i" onclick="mostrarPopup(@i)" />
        }
    </div>

    <!-- Modal Popup sobrepuesto -->
    <div id="popup" class="popup-overlay">
        <div class="popup-contenido">
            <span class="cerrar" onclick="cerrarPopup()">&times;</span>
            <div id="contenidoPopup"></div>
        </div>
    </div>

    <div class="teclado">
        <input type="text" id="input" class="input-terror" readonly placeholder="...">
        
        <div class="teclas-maquina">
            <button class="tecla tecla-circulo" onclick="agregarNumero(1)">1</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(2)">2</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(3)">3</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(4)">4</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(5)">5</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(6)">6</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(7)">7</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(8)">8</button>
            <button class="tecla tecla-circulo" onclick="agregarNumero(9)">9</button>
            <div class="vacio"></div>
            <button class="tecla tecla-circulo" onclick="agregarNumero(0)">0</button>
            <div class="vacio"></div>
        </div>

        <div class="teclado-acciones">
            <button class="btn-terror btn-accion" onclick="borrar()">Borrar</button>
            <form method="post" action="@Url.Action("VerificarRespuesta", "Home")" class="form-inline">
                <input type="hidden" name="respuesta" id="respuesta">
                <input type="hidden" name="salaId" value="@ViewBag.sala.IdSala">
                <input type="submit" class="btn-terror btn-enviar" value="Enviar">
            </form>
        </div>
    </div>

    <button class="btn-terror btn-pista" onclick="mostrarPista()">Pista</button>
    <input type="hidden" id="pista" value="@ViewBag.sala.Pista">
    <div id="pistaMsj" class="pista-caja"></div>
</div>