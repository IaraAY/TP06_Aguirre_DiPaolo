@{
    ViewData["Title"] = "Tipo 3";
}
<div class="sala-container">
    <h1 class="titulo-terror">@ViewBag.sala.Nombre</h1>
    <p class="texto-descripcion">@ViewBag.sala.Texto</p>
    <div class="imagen-frame">
        <img src="~/images/@ViewBag.sala.Imagen" alt="Imagen de la sala" />
    </div>

    <div class="controles-simon">
        <button id="btnVerSecuencia" class="btn-terror btn-advertencia" onclick="reproducirSecuencia()">Ver Secuencia de Pasos</button>
        <p id="estadoSimon" class="estado-simon-terror"></p>
    </div>

    <div class="simon-container">
        <button class="paso-btn" id="btn-R" onclick="presionarBoton('R')">Rueda de carro</button>
        <button class="paso-btn" id="btn-U" onclick="presionarBoton('U')">UP elevado</button>
        <button class="paso-btn" id="btn-L" onclick="presionarBoton('L')">L-jump</button>
        <button class="paso-btn" id="btn-Y" onclick="presionarBoton('Y')">Y-scale</button>
        <button class="paso-btn" id="btn-C" onclick="presionarBoton('C')">Cruce de brazos</button>
        <button class="paso-btn" id="btn-O" onclick="presionarBoton('O')">Onda de cadera</button>
        <button class="paso-btn" id="btn-N" onclick="presionarBoton('N')">Nivelación de pirámide</button>
        <button class="paso-btn" id="btn-W" onclick="presionarBoton('W')">Wave de pompones</button>
        <button class="paso-btn" id="btn-F" onclick="presionarBoton('F')">Flexión de rodillas</button>
        <button class="paso-btn" id="btn-E" onclick="presionarBoton('E')">Explosión final</button>
        <button class="paso-btn" id="btn-V" onclick="presionarBoton('V')">V-sit alto</button>
    </div>

    <form id="formRespuesta" method="post" action="@Url.Action("VerificarRespuesta", "Home")" class="form-acciones">
        <input type="hidden" name="respuesta" id="respuesta" />
        <input type="hidden" name="salaId" value="@ViewBag.sala.IdSala" />
        <button type="submit" class="btn-terror btn-enviar" id="btnEnviar" disabled>Confirmar Secuencia</button>
        <button type="button" class="btn-terror btn-accion" onclick="reiniciarSecuencia()">Reiniciar</button>
    </form>

    <div class="pista-seccion">
        <button class="btn-terror btn-pista" onclick="mostrarPista()">Pista</button>
        <input type="hidden" id="pista" value="@ViewBag.sala.Pista" />
        <div id="pistaMsj" class="pista-caja"></div>
    </div>
</div>