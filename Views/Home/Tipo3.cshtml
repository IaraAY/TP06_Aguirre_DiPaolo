@{
    ViewData["Title"] = "Tipo 3";
}
<h1>@ViewBag.sala.Nombre</h1>
<p>@ViewBag.sala.Texto</p>
<img src="~/images/@ViewBag.sala.Imagen" alt="Imagen de la sala" style="max-width: 100%; height: auto;" />

<div class="controles-simon">
    <button id="btnVerSecuencia" class="btn btn-warning" onclick="reproducirSecuencia()">Ver Secuencia de Pasos</button>
    <p id="estadoSimon" style="margin-top: 10px; font-weight: bold;"></p>
</div>

<!-- Tablero del Simon Dice con los movimientos de la Porrista -->
<div class="simon-container">
    <button class="paso-btn" id="btn-C" onclick="presionarBoton('C', 'Cruce de brazos')">Cruce de brazos</button>
    <button class="paso-btn" id="btn-R" onclick="presionarBoton('R', 'Rueda de carro')">Rueda de carro</button>
    <button class="paso-btn" id="btn-O" onclick="presionarBoton('O', 'Onda de cadera')">Onda de cadera</button>
    <button class="paso-btn" id="btn-W" onclick="presionarBoton('W', 'Wave de pompones')">Wave de pompones</button>
    <button class="paso-btn" id="btn-E" onclick="presionarBoton('E', 'Explosión final')" style="grid-column: span 2;">Explosión final</button>
</div>

<!-- Formulario oculto que envía la respuesta al servidor -->
<form id="formRespuesta" method="post" action="@Url.Action("VerificarRespuesta", "Home")" style="text-align: center; margin-top: 15px;">
    <input type="hidden" name="respuesta" id="respuesta" />
    <input type="hidden" name="salaId" value="@ViewBag.sala.IdSala" />
    <button type="submit" class="btn btn-primary" id="btnEnviar" disabled>Confirmar Secuencia</button>
    <button type="button" class="btn btn-danger" onclick="reiniciarSecuencia()">Reiniciar</button>
</form>

<div style="text-align: center; margin-top: 15px;">
    <button class="btn btn-secondary" onclick="mostrarPista()">Pista</button>
    <input type="hidden" id="pista" value="@ViewBag.sala.Pista" />
    <div id="pistaMsj" style="display:none; margin-top:10px; font-style: italic;"></div>
</div>