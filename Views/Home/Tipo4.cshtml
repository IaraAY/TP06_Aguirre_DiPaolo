<h1>@ViewBag.sala.Nombre</h1>
<p>@ViewBag.sala.Texto</p>
<img src="~/images/@ViewBag.sala.Imagen" alt="Imagen de la Cipher Machine" style="max-width: 100%; height: auto; border-radius: 8px; margin-bottom: 15px;" />

<div class="cipher-container">
    <h3>DECODIFICANDO CIPHER MACHINE</h3>
    
    <!-- Progreso del Decodificado -->
    <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progressFill"></div>
    </div>
    <p id="txtProgreso">Reparación: 0%</p>

    <!-- Minijuego Skill Check -->
    <div id="sectionSkillCheck">
        <div class="skillcheck-box">
            <div class="circle-target" id="targetArea"></div>
            <div class="needle" id="needle"></div>
            <div class="circle-center">
                <span style="font-size: 0.8rem; color: #aaa;">SKILL CHECK</span>
            </div>
        </div>

        <button class="btn btn-warning btn-lg w-100" id="btnHit" onclick="hitSkillCheck()">¡DECODIFICAR! (Espacio)</button>
        <button class="btn btn-secondary mt-2" id="btnStart" onclick="iniciarSkillCheck()">Iniciar Cipher</button>
    </div>

    <hr style="border-color: #444; margin: 25px 0;" />

    <!-- Teclado para ingresar el código final 050005 -->
    <div class="keypad-box" id="keypadBox">
        <p style="color: #00ff66; font-size: 0.9rem;">✔ CIPHER DECODIFICADA — INGRESE EL CÓDIGO DE REINICIO</p>
        <div class="display-code" id="displayInput">______</div>

        <div class="grid-teclas">
            <button class="btn-tecla" onclick="pressKey('1')">1</button>
            <button class="btn-tecla" onclick="pressKey('2')">2</button>
            <button class="btn-tecla" onclick="pressKey('3')">3</button>
            <button class="btn-tecla" onclick="pressKey('4')">4</button>
            <button class="btn-tecla" onclick="pressKey('5')">5</button>
            <button class="btn-tecla" onclick="pressKey('6')">6</button>
            <button class="btn-tecla" onclick="pressKey('7')">7</button>
            <button class="btn-tecla" onclick="pressKey('8')">8</button>
            <button class="btn-tecla" onclick="pressKey('9')">9</button>
            <button class="btn-tecla" onclick="clearInput()">C</button>
            <button class="btn-tecla" onclick="pressKey('0')">0</button>
            <button class="btn-tecla" onclick="pressKey('C')">←</button>
        </div>

        <form method="post" action="@Url.Action("VerificarRespuesta", "Home")" class="mt-3">
            <input type="hidden" name="respuesta" id="respuesta" />
            <input type="hidden" name="salaId" value="@ViewBag.sala.IdSala" />
            <button type="submit" class="btn btn-success w-100" id="btnEnviar" disabled>Enviar Código</button>
        </form>
    </div>
</div>

<div style="text-align: center; margin-top: 15px;">
    <button class="btn btn-secondary" onclick="mostrarPista()">Pista</button>
    <input type="hidden" id="pista" value="@ViewBag.sala.Pista" />
    <div id="pistaMsj" style="display:none; margin-top:10px; font-style: italic;"></div>
</div>