<div class="sala-container">
    <h1 class="titulo-terror">@ViewBag.sala.Nombre</h1>
    <p class="texto-descripcion">@ViewBag.sala.Texto</p>
    <div class="imagen-frame">
        <img src="~/images/@ViewBag.sala.Imagen" alt="Imagen de la sala">
    </div>

    <div class="teclado">
        <input type="text" id="input" class="input-terror" readonly placeholder="...">
        
        <div class="teclas-maquina">
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(1)">1</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(2)">2</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(3)">3</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(4)">4</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(5)">5</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(6)">6</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(7)">7</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(8)">8</button>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(9)">9</button>
            <div class="vacio"></div>
            <button type="button" class="tecla tecla-circulo" onclick="agregarNumero(0)">0</button>
            <div class="vacio"></div>
        </div>

        <div class="teclado-acciones">
            <button type="button" class="btn-terror btn-accion" onclick="borrar()">Borrar</button>
            <form method="post" action="@Url.Action("VerificarRespuesta", "Home")" class="form-inline">
                <input type="hidden" name="respuesta" id="respuesta">
                <input type="hidden" name="salaId" value="@ViewBag.sala.IdSala">
                <input type="submit" class="btn-terror btn-enviar" value="Enviar">
            </form>
        </div>
    </div>

    <div class="pista-seccion">
        <button type="button" class="btn-terror btn-pista" onclick="mostrarPista()">Pista</button>
        <input type="hidden" id="pista" value="@ViewBag.sala.Pista">
        <div id="pistaMsj" class="pista-caja"></div>
    </div>
</div>