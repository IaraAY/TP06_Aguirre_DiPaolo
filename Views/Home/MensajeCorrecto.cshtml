@{
    ViewData["Title"] = "¡Respuesta Correcta!";
}

<div class="sala-container">
    <!-- Contenedor con formato de documento/expediente confidencial -->
    <div class="mensaje-correcto">
        <h2>@ViewBag.sala.MensajeCorrecto</h2>
    </div>

    @if (ViewBag.sala.ImagenCorrecto != null)
    {
        <div class="imagen-frame">
            <img src="~/images/@ViewBag.sala.ImagenCorrecto" alt="Imagen de la sala">
        </div>
    }

    <!-- Botón estilizado y centrado -->
    <div class="mt-4">
        <button class="btn btn-terror btn-lg" onclick="location.href='@Url.Action("SiguienteNivel", "Home")'">
            Siguiente Sala
        </button>
    </div>
</div>